{
  "type": "minecraft:multi_action",
  "title": "Sit Anywhere!",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": [
        {
          "text": "v3.1.0",
          "bold": true
        },
        "\n",
        {
          "translate": "sitanywhere.by",
          "fallback": "By %s",
          "with": [
            {
              "text": "SozoKa",
              "color": "red"
            }
          ],
          "color": "gray",
          "bold": false
        },
        "\n\n",
        {
          "translate": "sitanywhere.made_for",
          "fallback": "Made for %s",
          "with": [
            {
              "text": "1.19.4 - 26.3",
              "color": "white"
            }
          ],
          "color": "gray",
          "bold": false
        },
        "\n",
        {
          "translate": "sitanywhere.may_work",
          "fallback": "but may work on newer versions!",
          "color": "gray",
          "bold": false
        }
      ]
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "translate": "sitanywhere.about.description",
        "fallback": "Allows you to sit anywhere you'd like!"
      },
      "width": 300
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "translate": "sitanywhere.about.explanations",
        "fallback": "Look all the way down, quickly double tap sneak, right-click... Boom, you now sit on the block!\n\nYou can also just stand on a slab or a stair block and right-click it!"
      },
      "width": 300
    }
  ],
  "actions": [
    {
      "label": "Modrinth",
      "tooltip": "§7§ohttps://modrinth.com/datapack/sit-anywhere!",
      "action": {
        "type": "open_url",
        "url": "https://modrinth.com/datapack/sit-anywhere!"
      }
    },
    {
      "label": "YouTube",
      "tooltip": "§7§ohttps://youtube.com/@SozoKa",
      "action": {
        "type": "open_url",
        "url": "https://youtube.com/@SozoKa"
      }
    },
    {
      "label": {
        "translate": "sitanywhere.issues",
        "fallback": "Issues"
      },
      "tooltip": "§7§ohttps://github.com/SozoKa/Sit-Anywhere/issues",
      "action": {
        "type": "open_url",
        "url": "https://github.com/SozoKa/Sit-Anywhere/issues"
      }
    },
    {
      "label": {
        "translate": "sitanywhere.changelog",
        "fallback": "Changelog"
      },
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "sitanywhere:changelog"
      }
    },
    {
      "label": {
        "translate": "sitanywhere.settings",
        "fallback": "Settings"
      },
      "tooltip": {
        "translate": "sitanywhere.need_op",
        "fallback": "Need OP permissions!",
        "color": "red"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "function sitanywhere:settings/dialog/open"
      }
    },
    {
      "label": {
        "translate": "sitanywhere.uninstall",
        "fallback": "Uninstall"
      },
      "tooltip": {
        "translate": "sitanywhere.need_op",
        "fallback": "Need OP permissions!",
        "color": "red"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "dialog show @s sitanywhere:uninstall"
      }
    }
  ],
  "exit_action": {
    "action": {
      "type": "show_dialog",
      "dialog": "smithed:data_packs"
    },
    "label": {
      "translate": "gui.back"
    },
    "width": 200
  }
}