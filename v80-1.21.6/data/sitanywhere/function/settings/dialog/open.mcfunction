data modify storage sitanywhere:settings dialog set value {type:"minecraft:multi_action",title:["Sit Anywhere! - ",{translate:"sitanywhere.settings",fallback:"Settings"}],body:[{type:"minecraft:plain_message",contents:{text:""}}],inputs:[{type:"minecraft:boolean",key:"global",label:{translate:"sitanywhere.settings.can_sit_anywhere",fallback:"Can sit anywhere with double-sneak?"},initial:0,on_true:"1",on_false:"0"},{type:"minecraft:boolean",key:"block",label:{translate:"sitanywhere.settings.can_sit_on_blocks",fallback:"Dedicated sitting method on stairs and slabs?"},initial:0,on_true:"1",on_false:"0"},{type:"minecraft:single_option",key:"type",label:{translate:"sitanywhere.settings.which_blocks",fallback:"Can sit on"},label_visible:1,options:[{id:"1",display:{translate:"sitanywhere.settings.stairs_and_slabs",fallback:"Stairs and Slabs"},initial:0},{id:"2",display:{translate:"sitanywhere.settings.stairs",fallback:"Stairs"},initial:0},{id:"3",display:{translate:"sitanywhere.settings.slabs",fallback:"Slabs"},initial:0}]},{type:"minecraft:boolean",key:"broadcast",label:{translate:"sitanywhere.settings.broadcast",fallback:"Broadcast changes?"}}],can_close_with_escape:1,after_action:"close",exit_action:{label:{translate:"gui.back"},width:200,action:{type:"minecraft:show_dialog",dialog:"sitanywhere:about"}},columns:1,actions:[{label:{translate:"structure_block.mode.save"},width:200,action:{type:"minecraft:dynamic/run_command",template:"function sitanywhere:settings/apply {global:$(global),block:$(block),type:$(type),broadcast:$(broadcast)}"}}]}

